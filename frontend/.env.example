# ==============================================================================
# AgentPay AI Web Application (Next.js 16 Frontend) - Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Network Environment Mode
#
# NEXT_PUBLIC_ENVIRONMENT:
#   - "production"  : Mainnet Mode — default Arc Mainnet (5042); BotChain 677 still switchable
#   - "development" : Testnet Mode — default Arc Testnet (5042002); BotChain 968 still switchable
# NEXT_PUBLIC_DEFAULT_CHAIN: "arc" | "botchain"
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT="production"
NEXT_PUBLIC_DEFAULT_CHAIN="arc"

# ------------------------------------------------------------------------------
# Backend API Gateway Endpoint
# 
# Production  : "https://agentpay-backend-c7c5.onrender.com" (Render Gateway)
# Development : "http://localhost:3001" (Local Express Gateway)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://agentpay-backend-c7c5.onrender.com"

# ------------------------------------------------------------------------------
# Privy Authentication App ID
# Get app ID from Privy Dashboard: https://dashboard.privy.io/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"

# ------------------------------------------------------------------------------
# Arc (default chain) — USDC x402. All NEXT_PUBLIC_* are non-sensitive.
# Registry proxy is also payTo (same as BotChain). Fill after DeployArcRegistry.
# APAY address stays empty until setApayToken on the Arc registry.
#
# USDC Addresses: On Arc, USDC is a precompile at 0x360…000. Differentiated
# per-network so mainnet/testnet can be overridden independently.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
NEXT_PUBLIC_ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"
NEXT_PUBLIC_USDC_ADDRESS_ARC_MAINNET="0x3600000000000000000000000000000000000000"
NEXT_PUBLIC_USDC_ADDRESS_ARC_TESTNET="0x3600000000000000000000000000000000000000"
NEXT_PUBLIC_AGENT_PAY_REGISTRY_ARC_TESTNET_ADDRESS=""
NEXT_PUBLIC_AGENT_PAY_REGISTRY_ARC_MAINNET_ADDRESS=""
NEXT_PUBLIC_PAYMENT_RECIPIENT_ARC_TESTNET=""
NEXT_PUBLIC_PAYMENT_RECIPIENT_ARC_MAINNET=""
NEXT_PUBLIC_APAY_TOKEN_ADDRESS_ARC=""

# ------------------------------------------------------------------------------
# BotChain contracts (kept for the chain switcher)
# ------------------------------------------------------------------------------
# BotChain Testnet Contracts (Chain ID 968)
NEXT_PUBLIC_APAY_TOKEN_ADDRESS_TESTNET="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"
NEXT_PUBLIC_USDT_TOKEN_ADDRESS_TESTNET="0x75edC9335175Fc0552D51D48439F229c10420fe3"
NEXT_PUBLIC_USDC_ADDRESS_BOTCHAIN_TESTNET=""
NEXT_PUBLIC_AGENT_PAY_REGISTRY_TESTNET_ADDRESS="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"

# BotChain Mainnet Contracts (Chain ID 677)
NEXT_PUBLIC_APAY_TOKEN_ADDRESS_MAINNET="0x4a781889Ce38c08B86b02e084A5A19609376b857"
NEXT_PUBLIC_USDT_TOKEN_ADDRESS_MAINNET="0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C"
NEXT_PUBLIC_USDC_ADDRESS_BOTCHAIN_MAINNET=""
NEXT_PUBLIC_WBOT_TOKEN_ADDRESS_MAINNET="0xD5452816194a3784dBa983426cCe7c122F4abd30"
NEXT_PUBLIC_BOUSDT_TOKEN_ADDRESS_MAINNET=""
NEXT_PUBLIC_AGENT_PAY_REGISTRY_MAINNET_ADDRESS="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"

# BotChain DEX & Hybrid Zap Contracts (Mainnet 677)
NEXT_PUBLIC_HYBRID_ZAP_ADDRESS_MAINNET="0x3dE7Ad9D36586C8aA69AD6d72c5F3aadE611689d"
NEXT_PUBLIC_BDEX_V2_FACTORY_MAINNET="0x117115f3B72C8d1989178089A67D0C26f8EE0AA3"
NEXT_PUBLIC_BDEX_V2_ROUTER_MAINNET="0x1414eD29FdFD322c3c0a830330ed982E2D629e76"
