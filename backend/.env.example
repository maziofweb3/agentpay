# ==============================================================================
# AgentPay AI API Gateway (Express Backend) - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq LPU API Configuration (Primary Ultra-Fast AI Provider - 100% Free)
# Get free key from Groq Console: https://console.groq.com/keys
# Multiple keys supported via comma-separated string for high-availability:
# GROQ_API_KEY="gsk_1...,gsk_2..."
# ------------------------------------------------------------------------------
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
DEFAULT_AI_PROVIDER="groq"

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Automatic Failover Backup Provider)
# Get key from Google AI Studio: https://aistudio.google.com/apikey
# Multiple keys supported via comma-separated string for failover:
# GEMINI_API_KEY="AIzaSy1...,AIzaSy2..."
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-lite-latest"

# ------------------------------------------------------------------------------
# Anthropic Claude API Configuration (Alternative AI Provider)
# Get key from Anthropic Console: https://console.anthropic.com/
# Multiple keys supported via comma-separated string for high-availability failover:
# ANTHROPIC_API_KEY="sk-ant-1...,sk-ant-2..."
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="your_anthropic_claude_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# Network mode (default is Arc)
#
# X402_NETWORK:
#   - "arc-testnet"       : Arc Testnet   (Chain ID 5042002, CAIP-2: eip155:5042002)  [default]
#   - "arc-mainnet"       : Arc Mainnet   (Chain ID 5042,    CAIP-2: eip155:5042)
#   - "testnet"           : BotChain Testnet (Chain ID 968,  CAIP-2: eip155:968)
#   - "mainnet"           : BotChain Mainnet (Chain ID 677,  CAIP-2: eip155:677)
# All four stay registered so the wallet switcher can settle on any of them.
# ------------------------------------------------------------------------------
X402_NETWORK="arc-testnet"
X402_EXTRA_NETWORKS="eip155:5042002,eip155:5042,eip155:968,eip155:677"

# ------------------------------------------------------------------------------
# Arc (USDC x402 via Circle Facilitator Service)
# payTo is the AgentPayRegistry proxy on each Arc net (same as BotChain).
# After DeployArcRegistry, set both registry and recipient to that proxy.
# CIRCLE_API_KEY_TESTNET / CIRCLE_API_KEY_MAINNET (Render secrets) so Circle
# can settle USDC to the Registry on each Arc net. CIRCLE_API_KEY is a fallback.
# APAY_TOKEN_ADDRESS_ARC stays empty until APAY is deployed on Arc.
# ------------------------------------------------------------------------------
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"
USDC_ADDRESS="0x3600000000000000000000000000000000000000"
CIRCLE_FACILITATOR_URL="https://api.circle.com/v1/facilitator/x402"
AGENT_PAY_REGISTRY_ARC_TESTNET=""
AGENT_PAY_REGISTRY_ARC_MAINNET=""
PAYMENT_RECIPIENT_ADDRESS_ARC_TESTNET=""
PAYMENT_RECIPIENT_ADDRESS_ARC_MAINNET=""
APAY_TOKEN_ADDRESS_ARC=""
ERC8004_IDENTITY_ARC_TESTNET="0x8004A818BFB912233c491871b3d84c89A494BD9e"
ERC8004_REPUTATION_ARC_TESTNET="0x8004B663056A597Dffe9eCcC1965A193B7388713"
ERC8004_IDENTITY_ARC_MAINNET="0x8004A169FB4a3325136EB29fA0ceB6D2e539a432"
ERC8004_REPUTATION_ARC_MAINNET="0x8004BAa17C55a88189AE136b182e5fdA19dE9b63"

# ------------------------------------------------------------------------------
# BotChain EVM Network & Token Infrastructure (kept for chain switcher)
# ------------------------------------------------------------------------------
BOTCHAIN_TESTNET_RPC_URL="https://rpc.bohr.life"
PAYMENT_RECIPIENT_ADDRESS_TESTNET="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"
APAY_TOKEN_ADDRESS_TESTNET="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"

BOTCHAIN_MAINNET_RPC_URL="https://rpc.botchain.ai"
PAYMENT_RECIPIENT_ADDRESS_MAINNET=""
APAY_TOKEN_ADDRESS_MAINNET="0x4a781889Ce38c08B86b02e084A5A19609376b857"

# Fallback generic environment variables (Backward compatibility)
BOTCHAIN_RPC_URL="https://rpc.bohr.life"
PAYMENT_RECIPIENT_ADDRESS="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"
APAY_TOKEN_ADDRESS="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"

# ------------------------------------------------------------------------------
# BOF (BotChain Open Facilitator) — BotChain APAY only
# ------------------------------------------------------------------------------
BOF_FACILITATOR_URL="https://bof-facilitator.onrender.com"

# ------------------------------------------------------------------------------
# Secrets — Dashboard only, never committed, never pushed as plain text
# CIRCLE_API_KEY_TESTNET=  # Arc testnet 5042002
# CIRCLE_API_KEY_MAINNET=  # Arc mainnet 5042
# CIRCLE_API_KEY=          # fallback if a per-net key is unset
# SELLER_PRIVATE_KEY=      # unused when a Circle API key is set
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# SESSION_SECRET=
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Server & Security
# ------------------------------------------------------------------------------
PORT=3001
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"

# ------------------------------------------------------------------------------
# Dynamic APAY Token Price Config (Optional - fetches live APAY/USD price from DEX or CoinGecko)
# ------------------------------------------------------------------------------
# API URL to fetch live APAY token price in USD (if empty, uses APAY_PRICE_FALLBACK_USD)
APAY_PRICE_API_URL="https://dex-wallet.botchain.ai/api/v1/price?token=0x4a781889Ce38c08B86b02e084A5A19609376b857&pool_type=all"
# Fallback $APAY token price in USD if API URL is empty or fails
APAY_PRICE_FALLBACK_USD="0.0038"
# In-memory price cache TTL in seconds (default: 3600 = 1 hour)
APAY_PRICE_CACHE_TTL_SEC="60"

# ------------------------------------------------------------------------------
# AgentPayRegistry On-Chain Recording
# ------------------------------------------------------------------------------
# Private key of the owner/deployer EOA that controls the AgentPayRegistry proxy.
# Required for recordPaymentAndPrompt() to be called after each settled payment.
# If unset, on-chain prompt recording is skipped (payment flow is unaffected).
REGISTRY_OWNER_PRIVATE_KEY=
